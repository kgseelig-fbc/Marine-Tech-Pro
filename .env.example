# Marine Tech Pro — environment variables.
# Copy to .env for local development (the app does not load .env itself; use
# `export`, `env`, or your process manager). Never commit real values.

# ---- Server -----------------------------------------------------------------

# Port to listen on. Railway sets this automatically.
PORT=3000

# 'production' enables Express production behaviour. Cookie Secure flag is
# derived from the connection (X-Forwarded-Proto), not from this.
NODE_ENV=production

# Public origin, no trailing slash. Builds the Google OAuth callback URL
# (<BASE_URL>/auth/google/callback) and is accepted as same-origin by the
# /api CSRF guard behind a proxy that rewrites Host.
BASE_URL=https://marinetech.example.com

# ---- Storage ----------------------------------------------------------------

# Directory for the SQLite database (mtp.db), the session store, and the
# generated secrets below. Defaults to /data when that directory exists,
# else ./data. On Railway mount a persistent volume here or every deploy
# wipes users, sessions and feedback.
DATA_DIR=/data

# ---- Secrets ----------------------------------------------------------------

# Signs the session cookie. Optional: when unset a random secret is generated
# once and persisted at DATA_DIR/session-secret (mode 0600), so sessions
# survive redeploys with no setup. To rotate without signing everyone out,
# set a comma-separated list — the first entry signs, every entry verifies.
SESSION_SECRET=

# Salt for the one-way IP hashes in the audit log. Optional: when unset a
# random salt is generated once and persisted at DATA_DIR/ip-hash-salt.
IP_HASH_SALT=

# Break-glass admin login (no user row, no second factor). Leave empty to
# disable. Use at least 12 — ideally 20+ — random characters; the server
# warns at startup if it is shorter. Rotating it revokes every existing
# break-glass session immediately.
ADMIN_CODE=

# ---- Sign-in ----------------------------------------------------------------

# Google SSO. Both required to enable the "Sign in with Google" button.
# Authorised redirect URI in Google Cloud: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails auto-approved as admin on their first GOOGLE sign-in
# (also promotes an already-pending Google user on their next sign-in).
# Local email/password signups never bootstrap — their email is unverified.
INITIAL_ADMIN_EMAILS=

# ---- Ask-a-Tech AI ----------------------------------------------------------

# Anthropic API key. Leave empty and /api/ask returns 503; everything else
# keeps working.
ANTHROPIC_API_KEY=

# Questions per minute per signed-in user (break-glass sessions: per IP).
ASK_RATE_PER_MIN=15

# ---- Abuse controls ---------------------------------------------------------

# Successful sign-ups allowed per hour per IP (failed attempts do not count).
SIGNUP_RATE_PER_HOUR=10

# ---- Housekeeping -----------------------------------------------------------

# Days of usage events and AI transcripts to keep (pruned at startup and
# daily). 0 disables pruning.
RETENTION_DAYS=90

# Milliseconds to drain in-flight requests after SIGTERM before exiting.
# Must be shorter than the platform's SIGKILL grace window — on Railway that
# window is 0 s unless RAILWAY_DEPLOYMENT_DRAINING_SECONDS is set (see README).
DRAIN_TIMEOUT_MS=25000

# Build id shown by /api/health and /admin. Railway supplies
# RAILWAY_GIT_COMMIT_SHA automatically; set GIT_SHA on other hosts.
GIT_SHA=

# Link target for the "FBC hub" button in the admin dashboard.
FBC_HUB_URL=https://freedomboatclub.ai
