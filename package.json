{
  "name": "marine-tech-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Field diagnostic and repair assistant for Freedom Boat Club marine technicians",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "exec node server.js",
    "test": "npm run validate && node --test test/*.test.js",
    "validate": "node scripts/validate-data.js",
    "icons": "node scripts/generate-icons.js",
    "check": "for f in server.js lib/*.js scripts/*.js public/js/*.js public/sw.js; do node --check \"$f\" || exit 1; done && node scripts/check-inline-scripts.js && npm run validate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "better-sqlite3-session-store": "^0.1.0",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
